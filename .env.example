# MP3 environment — OpenRouter (same pattern as Week12 capstone) or direct OpenAI
# Copy to .env or run:  ..\mp3\scripts\sync_openrouter_env.ps1
#
# PowerShell (no bash export needed):
#   Get-Content .env | ForEach-Object { ... }  # see scripts/run_eval_for_submission.ps1

# ─── Option A · OpenRouter (recommended if you used it in W7–W11) ───────────
MP3_USE_OPENROUTER=true
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MP3_CHAT_MODEL=openai/gpt-4o-mini
EMBED_MODEL=openai/text-embedding-3-small

# ─── Option B · OpenAI direct (course default) ────────────────────────────
# OPENAI_API_KEY=sk-...
# MP3_CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small

# Qdrant Cloud — https://cloud.qdrant.io
QDRANT_URL=https://YOUR-CLUSTER-ID.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional
QDRANT_TIMEOUT=60
RETRIEVAL_THRESHOLD=0.30
MP3_RETRIEVAL_K=8
# Use Week 9 MP2 Sherlock texts without copying (or run scripts/sync_corpus_from_week9.ps1)
# MP3_CORPUS_DIR=../../Week9_Capstone_mini/mp2/corpus